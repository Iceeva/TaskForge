# Database (use a pooled connection string for serverless -e.g. Neon, Supabase, or Vercel Postgres)
DATABASE_URL="postgresql://taskforge:taskforge_secret@localhost:5432/taskforge?pgbouncer=true&connection_limit=1"
# Direct (non-pooled) connection, used by Prisma Migrate -required by Neon/Supabase pooled setups
DIRECT_URL="postgresql://taskforge:taskforge_secret@localhost:5432/taskforge"

# Redis (optional -used for realtime presence/pubsub; skip on serverless-only deploys)
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="your-super-secret-jwt-key-change-this"
JWT_REFRESH_SECRET="your-refresh-secret"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/auth/google/callback"

# Server
PORT=4000
# Comma-separated list of allowed frontend origins (your Vercel frontend domain(s))
CORS_ORIGIN="http://localhost:3000,https://app.yourdomain.com"
FRONTEND_URL="http://localhost:3000"

# File Storage (Cloudinary or S3)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
